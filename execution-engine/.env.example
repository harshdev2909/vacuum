# RPC
RPC_URL=https://arb1.arbitrum.io/rpc
RPC_WS_URL=wss://arb1.arbitrum.io/ws
PRIVATE_RELAY_URL=

# Redis (queue + mempool snapshot)
REDIS_URL=redis://localhost:6379

# Auth (comma-separated keys)
API_KEYS=dev-key,prod-key

# Chain
CHAIN_ID=42161

# MEV & gas
MAX_GAS_MULTIPLIER=2
RISK_THRESHOLD=85
MAX_SLIPPAGE_BPS=300
MEMPOOL_WINDOW_BLOCKS=3

# Queue
QUEUE_NAME=execution-engine:tx-queue

# Server
PORT=8545
METRICS_ENABLED=true
LOG_LEVEL=info

# Optional: run only RPC (no mempool/worker)
# RUN_MEMPOOL=false
# RUN_WORKER=false
