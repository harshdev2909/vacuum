# Vacuum Agent — environment template
# Copy to .env and set values. Never commit .env.

# RPC (required)
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Chain (required)
CHAIN_ID=421614

# Signer (required for submit; use secure secret manager in production)
PRIVATE_KEY=0x...

# Agent behavior
DRY_RUN=true
LOG_LEVEL=info

# Optional: rule ID for DAO automation agent
RULE_ID=0x...

# Optional: strategy token ID for strategy agent
STRATEGY_TOKEN_ID=

# Optional: vault address for vault agent
VAULT_ADDRESS=
